SUBSYSTEM=="tty", ATTRS{idVendor}=="1209", ATTRS{idProduct}=="316d", GOTO="aura"
GOTO="not_aura"
LABEL="aura"
SUBSYSTEM=="tty", ATTRS{bInterfaceNumber}=="00", KERNEL=="ttyACM*", SYMLINK+="aura", SYMLINK+="aura"
SUBSYSTEM=="tty", ATTRS{bInterfaceNumber}=="02", KERNEL=="ttyACM*", SYMLINK+="aura-sec", SYMLINK+="aura-sec"
LABEL="not_aura"
